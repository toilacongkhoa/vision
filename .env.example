# Optional service credentials. Leave blank when Supabase is not used.
SUPABASE_URL=
SUPABASE_KEY=

# Server configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

# Defaults to https://eventretrieval.one
DRES_API_BASE_URL=https://eventretrieval.one
# Set false only when a broken HTTP(S)_PROXY environment blocks DRES.
DRES_TRUST_ENV=true
# DRES_USERNAME=
# DRES_PASSWORD=

# Optional absolute paths. Defaults point to files in the repository root.
# DB_PATH=C:\path\to\vision\video_index_v2.db
# CONSOLIDATED_VECTORS_PATH=C:\path\to\vision\all_vectors.npy
# DATA_ROOT=C:\path\to\vision\data
# TRAFFIC_DB_PATH=C:\path\to\vision\camera\traffic_search.db
# Keep the image/text encoder aligned with the checkpoint used to build the vectors.
# CLIP_MODEL_NAME=ViT-B-32-quickgelu
# CLIP_PRETRAINED=openai

# Only needed when `agy` is not available on PATH.
# AGY_PATH=C:\Users\your-name\AppData\Local\agy\bin\agy.exe
# Set false to avoid starting the Flash and Pro Agy sessions at server startup.
# They start on demand when a chat request arrives.
AGY_PREWARM_ON_STARTUP=true

# Read-only MCP endpoint for Codex/ChatGPT integration. Keep loopback-only
# until an authenticated HTTPS tunnel or production reverse proxy is ready.
MCP_HOST=127.0.0.1
MCP_PORT=8001
# MCP_API_KEY=your-secret-api-key-here
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

